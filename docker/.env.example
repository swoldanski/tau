# Copy this file to docker/.env and fill in the providers you use.
#   cp docker/.env.example docker/.env
#
# Values are read by docker-compose.yml. You can also export the same
# variables in your shell and leave the file absent.

# --- Provider credentials (only add the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# --- Host user mapping ---
# Set to your host uid/gid so files the agent writes in the mounted
# workspace belong to you:  PUID=$(id -u)  PGID=$(id -g)
PUID=1000
PGID=1000

# --- Terminal ---
# TERM=screen-256color   # tmux/screen sessions
# TERM=xterm-256color    # most terminals
TERM=
